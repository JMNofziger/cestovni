# Postgres connection string for the DSN role. That role must be able to SET ROLE cestovni_app. Apply migrations with npm run migrate before the process starts. The process does not migrate on boot.
DATABASE_URL=
# HS256 key for access tokens this API mints and checks. Required. At least 32 characters.
JWT_SECRET=
# Public base URL of this API. Written and checked as the access-token iss. Required. This is not Google's issuer URL.
AUTH_ISSUER_URL=
# Expected access-token audience. When unset, the API uses cestovni.
AUTH_AUDIENCE=
# Google OAuth web client id. Required. Stays on the server. Never put this in client config as a substitute for the server value, and never commit a real id here.
GOOGLE_CLIENT_ID=
# Google OAuth client secret. Required. Used only by this API when exchanging the authorization code. Server only.
GOOGLE_CLIENT_SECRET=
# TCP port the process listens on. When unset, the API uses 8080.
PORT=
# Bind address. When unset, the API uses 0.0.0.0.
HOST=
# How many X-Forwarded-For hops to trust, counted from the right. When unset, the API uses 0. Run a single instance.
TRUST_PROXY_HOPS=
# Comma-separated browser origins allowed for CORS. When unset, the API uses *.
CORS_ORIGINS=
# Where the Google callback sends the Android app. When unset, the API uses cestovni://auth/callback.
AUTH_ANDROID_REDIRECT=
# Exact portal callback URL. Optional. When set, it must be an absolute http or https URL.
AUTH_PORTAL_REDIRECT=
# Mutations allowed per user per 60 seconds. When unset, the API uses 60. Keep this below 100 so a burst stays under the per-request batch cap.
RATE_LIMIT_MUTATIONS_PER_MIN=
# Changes and restore-manifest requests allowed per user per 60 seconds. When unset, the API uses 120.
RATE_LIMIT_CHANGES_PER_MIN=
